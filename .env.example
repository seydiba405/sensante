# Copier vers .env et renseigner les valeurs.
# En Docker / prod : passer ces variables au runtime (pas besoin pour `next build`).

# Base de données (obligatoire au démarrage de l’app pour Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sensante?schema=public"

# Groq API (appels IA en runtime)
GROQ_API_KEY="votre-cle-groq-ici"

# NextAuth
NEXTAUTH_SECRET="generer-une-chaine-aleatoire-longue"
NEXTAUTH_URL="http://localhost:3000"
